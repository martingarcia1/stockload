# Copiar este archivo como ".env" y completar los valores reales.
# El archivo .env NO se sube a GitHub.

DB_PASSWORD=UnaContraseñaFuerte!2026

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Texto aleatorio de 64 caracteres o más
JWT_SECRET=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Facturación electrónica ARCA (Factura C)
# homologacion = pruebas sin validez fiscal | produccion = facturas reales
ARCA_ENTORNO=homologacion
# Certificado y clave: copiar el .crt y el .key en backend/StockApi/arca/<entorno>/
# (o pegar aquí el texto PEM completo en una línea, con \n en los saltos de línea)
ARCA_CERT=
ARCA_KEY=
